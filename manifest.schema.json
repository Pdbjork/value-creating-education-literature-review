{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Pdbjork/value-creating-education-literature-review/manifest.schema.json",
  "title": "Value-Creating Education Document Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "collection", "documents"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "collection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "description", "language", "publicationStatus", "preparedBy"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "language": { "type": "string", "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$" },
        "publicationStatus": { "type": "string", "minLength": 1 },
        "preparedBy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "credentials", "affiliation", "program", "display"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "credentials": { "type": "string", "minLength": 1 },
            "affiliation": { "type": "string", "minLength": 1 },
            "program": { "type": "string", "minLength": 1 },
            "display": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "figure", "title", "shortTitle", "documentType", "stance", "summary", "tags", "formats", "pageCount"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "figure": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "shortTitle": { "type": "string", "minLength": 1 },
          "documentType": { "type": "string", "pattern": "^[a-z]+(?:-[a-z]+)*$" },
          "stance": { "type": "string", "pattern": "^[a-z]+(?:-[a-z]+)*$" },
          "summary": { "type": "string", "minLength": 1 },
          "tags": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "formats": {
            "type": "object",
            "additionalProperties": false,
            "required": ["html", "pdf"],
            "properties": {
              "html": { "type": "string", "pattern": "^documents/[a-z0-9-]+/index\\.html$" },
              "pdf": { "type": "string", "pattern": "^documents/[a-z0-9-]+/printable\\.pdf$" }
            }
          },
          "pageCount": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
